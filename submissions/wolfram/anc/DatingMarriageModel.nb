Cell[TextData[{
 "with the orange line the average utility in the system with marriage and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "1a5d8ad0-fef2-4baa-8ce1-358cd0244d70"],
 " and the blue line the system without marriage. The Uniform model gives a \
similar result:"
}], "Text",
