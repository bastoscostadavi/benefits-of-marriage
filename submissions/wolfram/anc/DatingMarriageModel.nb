Cell[TextData[{
 "The dynamics of the system happen in discrete steps ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[Element]", "\[CapitalNu]"}], TraditionalForm]],
  ExpressionUUID->"89f78eb8-ba4c-4a7b-999c-91d17e9c6390"],
 ". At each step ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "1eb909a2-47fc-470c-965f-6ec21052cc23"],
 ", all agents match at random with a new agent. In Wolfram language, the \
matching at each step can be generated easily using"
}], "Text",
 CellChangeTimes->{{3.8382024651540422`*^9, 
  3.838202570447611*^9}},ExpressionUUID->"9f20d213-807f-4bc5-a977-\
e6ab3eef4ab8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"var", "=", 
   RowBox[{"RandomSample", "[", 
    RowBox[{"Table", "[", 
     RowBox[{"k", ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Matching", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"var", "\[LeftDoubleBracket]", 
       RowBox[{"1", ";;", 
        FractionBox["n", "2"]}], "\[RightDoubleBracket]"}], ",", 
      RowBox[{"var", "\[LeftDoubleBracket]", 
       RowBox[{
        RowBox[{
         FractionBox["n", "2"], "+", "1"}], ";;", "n"}], 
       "\[RightDoubleBracket]"}]}], "}"}], "\[Transpose]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Matching", "\[LeftDoubleBracket]", 
  RowBox[{"1", ";;", "100"}], "\[RightDoubleBracket]"}]}], "Input",
 CellChangeTimes->{{3.838202575960041*^9, 3.838202606943056*^9}, {
  3.838203218788146*^9, 3.83820321990823*^9}, {3.838203567587387*^9, 
