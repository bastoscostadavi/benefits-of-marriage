Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", "4"], ",", 
   FractionBox["3", "4"], ",", 
   FractionBox[
    RowBox[{"u", "+", 
     RowBox[{"2", " ", "\[Sigma]"}]}], 
    RowBox[{"8", " ", 
     SuperscriptBox["\[Sigma]", "2"]}]], ",", 
   FractionBox[
    RowBox[{"u", "+", 
     RowBox[{"6", " ", "\[Sigma]"}]}], 
    RowBox[{"24", " ", 
