Cell["\<\
Now, the utilities will be updated using the affinities of the couples:\
\>", "Text",
 CellChangeTimes->{{3.838204265237081*^9, 
  3.8382042936289787`*^9}},ExpressionUUID->"49ca7fdb-34c5-417e-b2d5-\
fce19b646fb8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NewUtility", "=", 
    RowBox[{
    "Utility", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
   ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], "=", 
      RowBox[{
       RowBox[{"Couples", "\[LeftDoubleBracket]", 
        RowBox[{"t", "+", "1"}], "\[RightDoubleBracket]"}], 
       "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "NewUtility", "\[LeftDoubleBracket]", "a", "\[RightDoubleBracket]"}], 
      "=", 
      RowBox[{"A", "\[LeftDoubleBracket]", 
       RowBox[{"a", ",", "b"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "NewUtility", "\[LeftDoubleBracket]", "b", "\[RightDoubleBracket]"}], 
      "=", 
      RowBox[{"A", "\[LeftDoubleBracket]", 
       RowBox[{"b", ",", "a"}], "\[RightDoubleBracket]"}]}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"Couples", "\[LeftDoubleBracket]", 
        RowBox[{"t", "+", "1"}], "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Utility", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"Utility", ",", 
     RowBox[{"{", "NewUtility", "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.838204313103031*^9, 3.838204326352878*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"6ccc82aa-7d4b-4c06-be5a-7da0212ce311"],

