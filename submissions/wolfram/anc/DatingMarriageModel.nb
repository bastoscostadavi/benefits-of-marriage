 CellChangeTimes->{3.8382044117478533`*^9, 3.838297621330752*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"94f915e4-7d40-49f1-b153-df8bfe554274"]
}, Open  ]],

Cell[TextData[{
 "Applying these simple decision rules and using this stochastic matching \
process we can evolve the system a number ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", " "}], TraditionalForm]],ExpressionUUID->
  "0c0e3921-b42a-4512-959b-47af44e4d24d"],
 " of steps. Before doing this, let\[CloseCurlyQuote]s show our \
implementation of marriage.\nIf the affinity between a couple is higher than \
a certain fixed value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "\[Element]", "\[DoubleStruckCapitalR]"}], 
   TraditionalForm]],ExpressionUUID->"89fb1295-1fa9-48c7-9ee0-017f7d78f574"],
 ", then the couple will not match with new agents in the next steps of the \
evolution.\tThe difference in the implementation is that now, after getting \
Couples we will also construct the Married couples. For \[CapitalLambda]=1 we \
would add"
}], "Text",
 CellChangeTimes->{{3.8382045024801397`*^9, 3.838204593662529*^9}, {
  3.838204632643847*^9, 3.838204671395928*^9}, {3.83820473658642*^9, 
  3.838204780343021*^9}},ExpressionUUID->"96bb8259-1336-47ee-892a-\
739f46eb6a0b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalLambda]", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Married", "=", 
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"Couples", "\[LeftDoubleBracket]", 
     RowBox[{"t", "+", "1"}], "\[RightDoubleBracket]"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"A", "\[LeftDoubleBracket]", 
         RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
        RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
        "\[RightDoubleBracket]"}], ">", "\[CapitalLambda]"}], "&&", 
      RowBox[{
       RowBox[{
        RowBox[{"A", "\[LeftDoubleBracket]", 
         RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
         "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
        RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        "\[RightDoubleBracket]"}], ">", "\[CapitalLambda]"}]}], "&"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.838204767682732*^9, 3.838204794306016*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"389a6955-dee0-4dc0-83e2-c6cdd1fa6871"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"976", ",", "569"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"162", ",", "579"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"19", ",", "598"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"164", ",", "141"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"888", ",", "616"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"594", ",", "652"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"428", ",", "418"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"633", ",", "914"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"189", ",", "626"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"915", ",", "404"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"512", ",", "202"}], "}"}], ",", 
