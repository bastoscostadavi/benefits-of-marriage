}, Open  ]],

Cell["\<\
Then, in the next step t+2, the Married couples would not participate in the \
matching process. We can do this using\
\>", "Text",
 CellChangeTimes->{{3.8382047990482597`*^9, 
  3.838204839903655*^9}},ExpressionUUID->"55beeec3-378a-443f-9c09-\
e3d37f2f72d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"var\[CapitalLambda]", "=", 
   RowBox[{"RandomSample", "[", 
    RowBox[{"Complement", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{"k", ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", 
      RowBox[{"Flatten", "[", "Married", "]"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"Matching\[CapitalLambda]", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"var\[CapitalLambda]", "\[LeftDoubleBracket]", 
       RowBox[{"1", ";;", 
        FractionBox[
         RowBox[{"Length", "[", "var\[CapitalLambda]", "]"}], "2"]}], 
       "\[RightDoubleBracket]"}], ",", 
      RowBox[{"var\[CapitalLambda]", "\[LeftDoubleBracket]", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"Length", "[", "var\[CapitalLambda]", "]"}], "2"], "+", 
         "1"}], ";;", 
        RowBox[{"Length", "[", "var\[CapitalLambda]", "]"}]}], 
       "\[RightDoubleBracket]"}]}], "}"}], "\[Transpose]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.838204858087228*^9, 3.8382048716572247`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"9971d396-b400-43d2-b787-9692fcd6f695"],

Cell["instead of \[OpenCurlyDoubleQuote]var\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]Matching\[CloseCurlyDoubleQuote] as we used before.", \
"Text",
 CellChangeTimes->{{3.838204845177601*^9, 3.8382049569561453`*^9}, {
  3.8382051408080063`*^9, 3.838205141823447*^9}, {3.838206276357555*^9, 
  3.838206276628531*^9}, {3.8382063553161383`*^9, 3.838206374386106*^9}, {
  3.838292345561933*^9, 
  3.838292348345306*^9}},ExpressionUUID->"b5750277-b501-41cf-8022-\
7698dcaad8c7"],

Cell["\<\
We collected all these material and constructed the DatingMarriageModel \
function. Schematically we have:\
\>", "Text",
 CellChangeTimes->{{3.83822338072164*^9, 3.838223382033453*^9}, {
  3.838292357825843*^9, 
  3.8382923696567574`*^9}},ExpressionUUID->"1ad3b388-ae98-446f-9583-\
57ee95e2bf98"],

Cell["\<\
DatingMarriageModel[dist_,n_,\[Mu]_,\[Sigma]_,\[Mu]s_,\[Sigma]s_,\
\[CapitalLambda]_,T_] \
\[Rule]{A,Utility,Utility\[CapitalLambda],Couples,Couples\[CapitalLambda],\
Married}
\:200b
Input:
dist=Distribution used in the simulation, either \[OpenCurlyDoubleQuote]U\
\[CloseCurlyDoubleQuote]=Uniform or \[OpenCurlyDoubleQuote]N\
\[CloseCurlyDoubleQuote]=Normal/Gaussian;
n = Number of agents;
\[Mu],\[Sigma] = Mean and variance of the distribution that generates the \
off-diagonal elements of the affinity matrix;
\[Mu]s,\[Sigma]s = Mean and variance of the distribution that generates the \
diagonal elements of the affinity matrix;
\[CapitalLambda] = Parameter that defines marriage;
T = Number of steps of the simulaton.
\:200b
Output:
A = Affinity matrix N x N;
Utility = Utility matrix U x T, where u\[LeftDoubleBracket]t\
\[RightDoubleBracket]\[LeftDoubleBracket]k\[RightDoubleBracket] is the \
utility of agent k at step t in the system without marriage;
Utility\[CapitalLambda] = Utility matrix U x T, where u\[LeftDoubleBracket]t\
\[RightDoubleBracket]\[LeftDoubleBracket]k\[RightDoubleBracket] is the \
utility of agent k at step t in the system with marriage;
Couples = List of length T, with Couples\[LeftDoubleBracket]t\
\[RightDoubleBracket] the set of couples at step t in the system without \
marriage;
Couples\[CapitalLambda] = List of length T, with Couples\[LeftDoubleBracket]t\
\[RightDoubleBracket] the set of couples at step t in the system with marriage;
Married=List of all agents who get married. Combined with Couples\
\[CapitalLambda] one can create a list with agents married at each step t.\
\>", "Text",
 CellChangeTimes->{{3.835868676644629*^9, 3.8358689717225933`*^9}, {
   3.8358690052535667`*^9, 3.8358690059046917`*^9}, {3.8358690398612747`*^9, 
   3.835869148104452*^9}, 3.838200102236195*^9, {3.8382063590183287`*^9, 
   3.83820636779655*^9}, {3.838223093424623*^9, 3.838223096474365*^9}, {
   3.838223363610463*^9, 3.838223380044783*^9}, {3.8382924111278677`*^9, 
   3.838292413824018*^9}},ExpressionUUID->"b66ec39c-ade9-4f6c-9082-\
1a3b72cf09f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DatingMarriageModel", "[", 
   RowBox[{
   "dist_", ",", "n_", ",", "\[Mu]_", ",", "\[Sigma]_", ",", "\[Mu]s_", ",", 
    "\[Sigma]s_", ",", "\[CapitalLambda]_", ",", "T_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "A", ",", "Utility", ",", "Utility\[CapitalLambda]", ",", "Couples", ",",
       "Couples\[CapitalLambda]", ",", "Married", ",", "t", ",", "var", ",", 
      "var\[CapitalLambda]", ",", "Matching", ",", "Matching\[CapitalLambda]",
       ",", "a", ",", "b", ",", "Love", ",", "Love\[CapitalLambda]", ",", 
      "NewCouples", ",", "NewCouples\[CapitalLambda]", ",", "Infidels", ",", 
      "Infidels\[CapitalLambda]", ",", "CouplesToBreak", ",", 
      "CouplesToBreak\[CapitalLambda]", ",", "NewUtility", ",", 
      "NewUtility\[CapitalLambda]", ",", "k"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"dist", "\[Equal]", "\"\<N\>\""}], ",", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"A", "=", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"\[Mu]", ",", "\[Sigma]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
            "A", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], 
            "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], "=", 
           RowBox[{
            RowBox[{"RandomVariate", "[", 
             RowBox[{
              RowBox[{"NormalDistribution", "[", 
               RowBox[{"\[Mu]s", ",", "\[Sigma]s"}], "]"}], ",", "1"}], "]"}],
             "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"dist", "\[Equal]", "\"\<U\>\""}], ",", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"A", "=", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"UniformDistribution", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Mu]", "-", 
               RowBox[{"2", "\[Sigma]"}]}], ",", 
              RowBox[{"\[Mu]", "+", 
               RowBox[{"2", "\[Sigma]"}]}]}], "}"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
            "A", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], 
            "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], "=", 
           RowBox[{
            RowBox[{"RandomVariate", "[", 
             RowBox[{
              RowBox[{"UniformDistribution", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"\[Mu]s", "-", 
                  RowBox[{"2", "\[Sigma]s"}]}], ",", 
                 RowBox[{"\[Mu]s", "+", 
                  RowBox[{"2", "\[Sigma]s"}]}]}], "}"}], "]"}], ",", "1"}], 
             "]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], " ", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"A", " ", "is", " ", "the", " ", "affinity", " ", 
        RowBox[{"matrix", ".", " ", 
         SubscriptBox["A", "kj"]}], " ", "is", " ", "the", " ", "utility", 
        " ", "surplus", " ", "for", " ", "agent", " ", "k", " ", "when", " ", 
        "it", " ", "is", " ", "with", " ", "agent", " ", "j"}], ";", " ", 
       RowBox[{
        SubscriptBox["A", "kk"], " ", "is", " ", "the", " ", "utility", " ", 
        "for", " ", "agent", " ", "k", " ", "when", " ", "it", " ", "is", " ", 
        RowBox[{"single", "."}]}]}], "*)"}], " ", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Utility", "=", 
      RowBox[{"{", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"A", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}],
           "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], "}"}]}], ";", 
     " ", "\[IndentingNewLine]", 
     RowBox[{"Utility\[CapitalLambda]", "=", 
      RowBox[{"{", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"A", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}],
           "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], "}"}]}], ";", 
     " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Creates", " ", "a", " ", "list", " ", "with", " ", "the", " ", 
       "initial", " ", "utilities", " ", "in", " ", "the", " ", "system", " ",
        "with", " ", "marriage", " ", "and", " ", "in", " ", "the", " ", 
       "system", " ", "without", " ", "marriage", " ", "which", " ", "is", 
       " ", 
       SubscriptBox["A", "kk"], " ", "seems", " ", "all", " ", "agents", " ", 
       "are", " ", "singles", " ", 
       RowBox[{"initially", ".", " ", "We"}], " ", "are", " ", "using", " ", 
       "\[CapitalLambda]", " ", "to", " ", "denote", " ", "the", " ", 
       "attributes", " ", "of", " ", "the", " ", "system", " ", "with", " ", 
       "marriage"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Couples", "=", 
      RowBox[{"{", 
       RowBox[{"{", "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Couples\[CapitalLambda]", "=", 
      RowBox[{"{", 
       RowBox[{"{", "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Married", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"t", "=", 
         RowBox[{"Length", "[", "Utility", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Without", " ", "marriage"}], "*)"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"var", "=", 
         RowBox[{"RandomSample", "[", 
          RowBox[{"Table", "[", 
           RowBox[{"k", ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Matching", "=", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"var", "\[LeftDoubleBracket]", 
             RowBox[{"1", ";;", 
              FractionBox["n", "2"]}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{"var", "\[LeftDoubleBracket]", 
             RowBox[{
              RowBox[{
               FractionBox["n", "2"], "+", "1"}], ";;", "n"}], 
             "\[RightDoubleBracket]"}]}], "}"}], "\[Transpose]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"Random", " ", "matching", " ", "between", " ", "agents"}], 
         "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Love", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", ",", "b"}], "}"}], "=", 
             RowBox[{
             "Matching", "\[LeftDoubleBracket]", "i", 
              "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"A", "\[LeftDoubleBracket]", 
               RowBox[{"a", ",", "b"}], "\[RightDoubleBracket]"}], ">", 
              RowBox[{
               RowBox[{
               "Utility", "\[LeftDoubleBracket]", "t", 
                "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "a", 
               "\[RightDoubleBracket]"}]}], "&&", 
             RowBox[{
              RowBox[{"A", "\[LeftDoubleBracket]", 
               RowBox[{"b", ",", "a"}], "\[RightDoubleBracket]"}], ">", 
              RowBox[{
               RowBox[{
               "Utility", "\[LeftDoubleBracket]", "t", 
                "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "b", 
               "\[RightDoubleBracket]"}]}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "Matching", "]"}]}], "}"}]}], "]"}]}], 
        ";", " ", 
        RowBox[{"(*", 
         RowBox[{
         "Array", " ", "with", " ", "the", " ", "couples", " ", "that", " ", 
          "accept", " ", "each", " ", "other"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"NewCouples", "=", 
         RowBox[{"Pick", "[", 
          RowBox[{"Matching", ",", "Love"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Infidels", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", "NewCouples", "]"}], ",", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{
               "Couples", "\[LeftDoubleBracket]", "t", 
                "\[RightDoubleBracket]"}], "]"}], ",", "#"}], "]"}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"CouplesToBreak", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
           "Couples", "\[LeftDoubleBracket]", "t", "\[RightDoubleBracket]"}], 
           ",", 
           RowBox[{
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"Infidels", ",", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
              "]"}], "||", 
             RowBox[{"MemberQ", "[", 
              RowBox[{"Infidels", ",", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
              "]"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Couples", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"Couples", ",", 
           RowBox[{"{", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"Complement", "[", 
               RowBox[{
                RowBox[{
                "Couples", "\[LeftDoubleBracket]", "t", 
                 "\[RightDoubleBracket]"}], ",", "CouplesToBreak"}], "]"}], 
              ",", "NewCouples"}], "]"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Creates", " ", "a", " ", "new", " ", "entry", " ", "in", " ", 
           "couples", " ", "with", " ", "the", " ", "couples", " ", "at", " ",
            "the", " ", "next", " ", 
           RowBox[{"step", ".", " ", "The"}], " ", "couples", " ", "at", " ", 
           "the", " ", "next", " ", "step", " ", "are", " ", "the", " ", 
           "old", " ", "couples"}], " ", "-", " ", 
          RowBox[{"the", " ", "couples", " ", "that", " ", "broke"}], " ", 
          "+", " ", 
          RowBox[{"the", " ", "new", " ", "couples"}]}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Construct", " ", "the", " ", "utility", " ", "in", " ", "the", " ", 
          "next", " ", "step"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"NewUtility", "=", 
         RowBox[{
         "Utility", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
        ";", " ", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], "=", 
            RowBox[{
             RowBox[{"Couples", "\[LeftDoubleBracket]", 
              RowBox[{"t", "+", "1"}], "\[RightDoubleBracket]"}], 
             "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
            "NewUtility", "\[LeftDoubleBracket]", "a", 
             "\[RightDoubleBracket]"}], "=", 
            RowBox[{"A", "\[LeftDoubleBracket]", 
             RowBox[{"a", ",", "b"}], "\[RightDoubleBracket]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
            "NewUtility", "\[LeftDoubleBracket]", "b", 
             "\[RightDoubleBracket]"}], "=", 
            RowBox[{"A", "\[LeftDoubleBracket]", 
             RowBox[{"b", ",", "a"}], "\[RightDoubleBracket]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"Couples", "\[LeftDoubleBracket]", 
              RowBox[{"t", "+", "1"}], "\[RightDoubleBracket]"}], "]"}]}], 
           "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Utility", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"Utility", ",", 
           RowBox[{"{", "NewUtility", "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"With", " ", "marriage"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"var\[CapitalLambda]", "=", 
         RowBox[{"RandomSample", "[", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{"k", ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", 
            RowBox[{"Flatten", "[", "Married", "]"}]}], "]"}], "]"}]}], ";", 
        RowBox[{"Matching\[CapitalLambda]", "=", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"var\[CapitalLambda]", "\[LeftDoubleBracket]", 
             RowBox[{"1", ";;", 
              FractionBox[
               RowBox[{"Length", "[", "var\[CapitalLambda]", "]"}], "2"]}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"var\[CapitalLambda]", "\[LeftDoubleBracket]", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{"Length", "[", "var\[CapitalLambda]", "]"}], "2"], 
               "+", "1"}], ";;", 
              RowBox[{"Length", "[", "var\[CapitalLambda]", "]"}]}], 
             "\[RightDoubleBracket]"}]}], "}"}], "\[Transpose]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Love\[CapitalLambda]", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", ",", "b"}], "}"}], "=", 
             RowBox[{
             "Matching\[CapitalLambda]", "\[LeftDoubleBracket]", "i", 
              "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"A", "\[LeftDoubleBracket]", 
               RowBox[{"a", ",", "b"}], "\[RightDoubleBracket]"}], ">", 
              RowBox[{
               RowBox[{
               "Utility\[CapitalLambda]", "\[LeftDoubleBracket]", "t", 
                "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "a", 
               "\[RightDoubleBracket]"}]}], "&&", 
             RowBox[{
              RowBox[{"A", "\[LeftDoubleBracket]", 
               RowBox[{"b", ",", "a"}], "\[RightDoubleBracket]"}], ">", 
              RowBox[{
               RowBox[{
               "Utility\[CapitalLambda]", "\[LeftDoubleBracket]", "t", 
                "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "b", 
               "\[RightDoubleBracket]"}]}], "&&", 
             RowBox[{"Not", "[", 
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"Flatten", "[", "Married", "]"}], ",", "a"}], "]"}], 
              "]"}], "&&", 
             RowBox[{"Not", "[", 
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"Flatten", "[", "Married", "]"}], ",", "b"}], "]"}], 
              "]"}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "Matching\[CapitalLambda]", "]"}]}], 
            "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"NewCouples\[CapitalLambda]", "=", 
         RowBox[{"Pick", "[", 
          RowBox[{"Matching\[CapitalLambda]", ",", "Love\[CapitalLambda]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Infidels\[CapitalLambda]", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", "NewCouples\[CapitalLambda]", "]"}], ",", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{
               "Couples\[CapitalLambda]", "\[LeftDoubleBracket]", "t", 
                "\[RightDoubleBracket]"}], "]"}], ",", "#"}], "]"}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"CouplesToBreak\[CapitalLambda]", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
           "Couples\[CapitalLambda]", "\[LeftDoubleBracket]", "t", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"Infidels\[CapitalLambda]", ",", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
              "]"}], "||", 
             RowBox[{"MemberQ", "[", 
              RowBox[{"Infidels\[CapitalLambda]", ",", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
              "]"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Couples\[CapitalLambda]", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"Couples\[CapitalLambda]", ",", 
           RowBox[{"{", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"Complement", "[", 
               RowBox[{
                RowBox[{
                "Couples\[CapitalLambda]", "\[LeftDoubleBracket]", "t", 
                 "\[RightDoubleBracket]"}], ",", 
                "CouplesToBreak\[CapitalLambda]"}], "]"}], ",", 
              "NewCouples\[CapitalLambda]"}], "]"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Married", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Couples\[CapitalLambda]", "\[LeftDoubleBracket]", 
            RowBox[{"t", "+", "1"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"A", "\[LeftDoubleBracket]", 
                RowBox[{
                "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], ">", "\[CapitalLambda]"}], "&&", 
             RowBox[{
              RowBox[{
               RowBox[{"A", "\[LeftDoubleBracket]", 
                RowBox[{
                "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], ">", "\[CapitalLambda]"}]}], 
            "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"NewUtility\[CapitalLambda]", "=", 
         RowBox[{
         "Utility\[CapitalLambda]", "\[LeftDoubleBracket]", "1", 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], "=", 
            RowBox[{
             RowBox[{"Couples\[CapitalLambda]", "\[LeftDoubleBracket]", 
              RowBox[{"t", "+", "1"}], "\[RightDoubleBracket]"}], 
             "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
            "NewUtility\[CapitalLambda]", "\[LeftDoubleBracket]", "a", 
             "\[RightDoubleBracket]"}], "=", 
            RowBox[{"A", "\[LeftDoubleBracket]", 
             RowBox[{"a", ",", "b"}], "\[RightDoubleBracket]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
            "NewUtility\[CapitalLambda]", "\[LeftDoubleBracket]", "b", 
             "\[RightDoubleBracket]"}], "=", 
            RowBox[{"A", "\[LeftDoubleBracket]", 
             RowBox[{"b", ",", "a"}], "\[RightDoubleBracket]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"Couples\[CapitalLambda]", "\[LeftDoubleBracket]", 
              RowBox[{"t", "+", "1"}], "\[RightDoubleBracket]"}], "]"}]}], 
           "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Utility\[CapitalLambda]", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"Utility\[CapitalLambda]", ",", 
           RowBox[{"{", "NewUtility\[CapitalLambda]", "}"}]}], "]"}]}]}], ",",
        "\[IndentingNewLine]", "T"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
      "A", ",", "Utility", ",", "Utility\[CapitalLambda]", ",", "Couples", 
       ",", "Couples\[CapitalLambda]", ",", "Married"}], "}"}]}]}], 
   "]"}]}]], "Input",
