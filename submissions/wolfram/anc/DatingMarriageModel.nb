Cell["\<\
We can then compare the results with what we obtained with the simulations:\
\>", "Text",
 CellChangeTimes->{{3.838213275103506*^9, 
  3.838213297031028*^9}},ExpressionUUID->"3bdd39e0-8700-4345-a21a-\
c688060c9061"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rU", "=", 
   RowBox[{"DatingMarriageModel", "[", 
    RowBox[{
    "\"\<U\>\"", ",", "10000", ",", "0", ",", "1", ",", "0", ",", "1", ",", 
     "1", ",", "1"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.835781190099104*^9, 3.835781208498616*^9}, 
