Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Sigma]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NextStep", "[", 
   RowBox[{"p_", ",", "ps_", ",", "pc_", ",", "b_", ",", "r_"}], "]"}], ":=", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pA", ",", "ExV", ",", "fc", ",", "cn", ",", "cn1", ",", "Cn", ",", "fs",
       ",", "sn", ",", "sn1", ",", "Sn", ",", "n", ",", "k", ",", "l", ",", 
      "m", ",", "ml", ",", "bNext", ",", "pcNext", ",", "rNext", ",", 
      "psNext"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pA", "=", 
      FractionBox["1", 
       RowBox[{"4", "\[Sigma]"}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ExV", "[", 
       RowBox[{"exp_", ",", "dist_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{"exp", " ", "dist"}], ",", "u"}], "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{"u", "\[Rule]", 
           RowBox[{"2", "\[Sigma]"}]}], "}"}]}], ")"}], "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{"exp", " ", "dist"}], ",", "u"}], "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{"u", "\[Rule]", 
           RowBox[{
            RowBox[{"-", "2"}], "\[Sigma]"}]}], "}"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"If", " ", "in", " ", "a", " ", "couple"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fc", "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox["k", "n"], 
        RowBox[{"Integrate", "[", 
         RowBox[{"pA", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "ml", ",", 
            RowBox[{"2", "\[Sigma]"}]}], "}"}]}], "]"}], 
        RowBox[{"Integrate", "[", 
         RowBox[{"pA", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", 
            RowBox[{
             RowBox[{"-", "2"}], "\[Sigma]"}], ",", "m"}], "}"}]}], "]"}]}], 
       "+", 
       RowBox[{
        SuperscriptBox["k", "n"], 
        RowBox[{"Integrate", "[", 
         RowBox[{"pA", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", 
            RowBox[{
             RowBox[{"-", "2"}], "\[Sigma]"}], ",", "ml"}], "}"}]}], 
         "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cn", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Integrate", "[", 
         RowBox[{"pA", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "l", ",", 
            RowBox[{"2", "\[Sigma]"}]}], "}"}]}], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"pA", " ", 
           FractionBox[
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"2", "\[Sigma]"}], ")"}], 
               RowBox[{"n", "+", "1"}]], "-", 
              SuperscriptBox["k", 
               RowBox[{"n", "+", "1"}]]}], ")"}], 
            RowBox[{"n", "+", "1"}]]}], "+", 
          RowBox[{"fc", "  ", 
           RowBox[{"Integrate", "[", 
            RowBox[{"pA", ",", 
             RowBox[{"{", 
              RowBox[{"u", ",", 
               RowBox[{
                RowBox[{"-", "2"}], "\[Sigma]"}], ",", "k"}], "}"}]}], 
            "]"}]}]}], ")"}]}], "+", 
       RowBox[{"fc", " ", 
        RowBox[{"Integrate", "[", 
         RowBox[{"pA", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", 
            RowBox[{
             RowBox[{"-", "2"}], "\[Sigma]"}], ",", "l"}], "}"}]}], 
         "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cn1", "=", 
      RowBox[{"pA", " ", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"2", "\[Sigma]"}], ")"}], 
           RowBox[{"n", "+", "1"}]], "-", 
          SuperscriptBox["k", 
           RowBox[{"n", "+", "1"}]]}], ")"}], 
        RowBox[{"n", "+", "1"}]], 
       RowBox[{"Integrate", "[", 
        RowBox[{"pA", ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", "l", ",", 
           RowBox[{"2", "\[Sigma]"}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Cn", "=", 
      RowBox[{
       RowBox[{"b", " ", 
        RowBox[{"ExV", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ExV", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ExV", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ExV", "[", 
                  RowBox[{
                   RowBox[{"cn", "/.", 
                    RowBox[{"{", 
                    RowBox[{"k", "\[Rule]", "u"}], "}"}]}], ",", "pc"}], 
                  "]"}], "/.", 
                 RowBox[{"{", 
                  RowBox[{"l", "\[Rule]", "u"}], "}"}]}], ",", "p"}], "]"}], "/.", 
              RowBox[{"{", 
               RowBox[{"m", "\[Rule]", "u"}], "}"}]}], ",", "pc"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{"ml", "\[Rule]", "u"}], "}"}]}], ",", "p"}], "]"}]}], "+", 
       RowBox[{"r", " ", 
        RowBox[{"ExV", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ExV", "[", 
            RowBox[{
             RowBox[{"cn1", "/.", 
              RowBox[{"{", 
               RowBox[{"k", "\[Rule]", "u"}], "}"}]}], ",", "ps"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{"l", "\[Rule]", "u"}], "}"}]}], ",", "p"}], "]"}]}]}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"If", " ", "single"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fs", "=", 
      RowBox[{"pA", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"2", "\[Sigma]"}], ")"}], 
           RowBox[{"n", "+", "1"}]], "-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "\[Sigma]"}], ")"}], 
           RowBox[{"n", "+", "1"}]]}], ")"}], 
        RowBox[{"n", "+", "1"}]], 
       RowBox[{"Integrate", "[", 
        RowBox[{"pA", ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", "m", ",", 
           RowBox[{"2", "\[Sigma]"}]}], "}"}]}], "]"}], 
       RowBox[{"Integrate", "[", 
        RowBox[{"pA", ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", "ml", ",", 
           RowBox[{"2", "\[Sigma]"}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sn", "=", 
      RowBox[{
       RowBox[{"fs", " ", 
        RowBox[{"Integrate", "[", 
         RowBox[{"pA", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "l", ",", 
            RowBox[{"2", "\[Sigma]"}]}], "}"}]}], "]"}], 
        RowBox[{"Integrate", "[", 
         RowBox[{"pA", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", 
            RowBox[{
             RowBox[{"-", "2"}], "\[Sigma]"}], ",", "k"}], "}"}]}], "]"}]}], 
       "+", 
       RowBox[{"fs", " ", 
        RowBox[{"Integrate", "[", 
         RowBox[{"pA", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", 
            RowBox[{
             RowBox[{"-", "2"}], "\[Sigma]"}], ",", "l"}], "}"}]}], 
         "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sn1", "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox["k", "n"], 
        RowBox[{"Integrate", "[", 
         RowBox[{"pA", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", 
            RowBox[{
             RowBox[{"-", "2"}], "\[Sigma]"}], ",", "k"}], "}"}]}], "]"}], 
        RowBox[{"Integrate", "[", 
         RowBox[{"pA", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "l", ",", 
            RowBox[{"2", "\[Sigma]"}]}], "}"}]}], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox["k", "n"], 
        RowBox[{"Integrate", "[", 
         RowBox[{"pA", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", 
            RowBox[{
             RowBox[{"-", "2"}], "\[Sigma]"}], ",", "l"}], "}"}]}], 
         "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Sn", "=", 
      RowBox[{
       RowBox[{"b", " ", 
        RowBox[{"ExV", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ExV", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ExV", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ExV", "[", 
                  RowBox[{
                   RowBox[{"sn", "/.", 
                    RowBox[{"{", 
                    RowBox[{"k", "\[Rule]", "u"}], "}"}]}], ",", "pc"}], 
                  "]"}], "/.", 
                 RowBox[{"{", 
                  RowBox[{"l", "\[Rule]", "u"}], "}"}]}], ",", "p"}], "]"}], "/.", 
              RowBox[{"{", 
               RowBox[{"m", "\[Rule]", "u"}], "}"}]}], ",", "pc"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{"ml", "\[Rule]", "u"}], "}"}]}], ",", "p"}], "]"}]}], "+", 
       RowBox[{"r", " ", 
        RowBox[{"ExV", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ExV", "[", 
            RowBox[{
             RowBox[{"sn1", "/.", 
              RowBox[{"{", 
               RowBox[{"k", "\[Rule]", "u"}], "}"}]}], ",", "ps"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{"l", "\[Rule]", "u"}], "}"}]}], ",", "p"}], "]"}]}]}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Built", " ", "fractions", " ", "and", " ", "distributions"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bNext", "=", 
      RowBox[{"Cn", "/.", 
       RowBox[{"{", 
        RowBox[{"n", "\[Rule]", "0"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"rNext", "=", 
      RowBox[{"Sn", "/.", 
       RowBox[{"{", 
        RowBox[{"n", "\[Rule]", "0"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"pcNext", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        FractionBox["1", "bNext"], 
        SqrtBox[
         FractionBox["1", 
          RowBox[{"2", "\[Pi]"}]]], 
        RowBox[{"InverseFourierTransform", "[", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"Cn", " ", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"\[ImaginaryI]", " ", "k"}], ")"}], "n"], 
              RowBox[{"n", "!"}]]}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}], ",",
           "k", ",", "u"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"psNext", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        FractionBox["1", "rNext"], 
        SqrtBox[
         FractionBox["1", 
          RowBox[{"2", "\[Pi]"}]]], 
        RowBox[{"InverseFourierTransform", "[", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"Sn", " ", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"\[ImaginaryI]", " ", "k"}], ")"}], "n"], 
              RowBox[{"n", "!"}]]}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}], ",",
           "k", ",", "u"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"bNext", ",", "rNext", ",", "pcNext", ",", "psNext"}], 
      "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.835818507431388*^9, 3.8358189218123407`*^9}, {
   3.835818952655196*^9, 3.835818984500539*^9}, {3.835819050354521*^9, 
