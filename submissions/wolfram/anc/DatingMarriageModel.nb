  "Out[267]=",ExpressionUUID->"5369576a-2f97-446b-841d-7700f1ff07a0"]
}, Open  ]],

Cell[TextData[StyleBox["Again, we can compare the results obtained with data. \
We have:", "Text"]], "Text",
 CellChangeTimes->{{3.8358184070052967`*^9, 3.835818408933503*^9}, {
  3.838213425150506*^9, 
  3.838213438963491*^9}},ExpressionUUID->"c194ae90-c26e-491c-a494-\
b544042bcc35"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rU", "=", 
   RowBox[{"DatingMarriageModel", "[", 
    RowBox[{
    "\"\<U\>\"", ",", "10000", ",", "0", ",", "1", ",", "0", ",", "1", ",", 
     "1", ",", "2"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.835818425956959*^9, 3.835818426092916*^9}},
 CellLabel->
  "In[270]:=",ExpressionUUID->"1af355cf-89b0-44e5-b28d-ac39a61271db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"p", "=", 
  RowBox[{"{", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"4", "\[Sigma]"}]], ",", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"b1", " ", "pc1"}], "+", 
      RowBox[{"r1", " ", "ps1"}]}], "]"}], ",", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"b2", " ", "pc2"}], "+", 
      RowBox[{"r2", " ", "ps2"}]}], "]"}]}], "}"}]}]], "Input",
