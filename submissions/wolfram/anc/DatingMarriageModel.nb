Cell[TextData[{
 StyleBox["3.1.2. ", "Subsubsection"],
 "Step 2"
}], "Subsubsection",
 CellChangeTimes->{{3.835811500552247*^9, 3.835811501825214*^9}, {
  3.8358121429278097`*^9, 3.835812143599416*^9}, {3.835819754717555*^9, 
  3.835819790973287*^9}, {3.835820305905875*^9, 3.835820306978273*^9}, {
  3.838213497968075*^9, 
  3.838213499178314*^9}},ExpressionUUID->"74c4167c-9874-42e8-826f-\
402784428014"],

Cell["\<\
Using the results for step 1 we can using NextStep again to find the results \
for step 2:\
\>", "Text",
 CellChangeTimes->{{3.838213323054545*^9, 3.8382133519977913`*^9}, {
  3.838213398472118*^9, 3.838213398757345*^9}, {3.838224371761829*^9, 
  3.8382243727536173`*^9}},ExpressionUUID->"ce37e19c-5ee3-4b18-8eb6-\
dd2a0e849641"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"b2", ",", "r2", ",", "pc2", ",", "ps2"}], "}"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"NextStep", "[", 
     RowBox[{"p1", ",", "ps1", ",", "pc1", ",", "b1", ",", "r1"}], "]"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "\[Sigma]"}], "<", "u", "<", 
      RowBox[{"2", "\[Sigma]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.838224376281788*^9, 3.8382243868620234`*^9}, {
  3.838224419451187*^9, 3.8382244301804647`*^9}},
 CellLabel->
  "In[267]:=",ExpressionUUID->"d1b1e7f5-967e-4ac8-94e5-35c99f260b7f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1861", "5184"], ",", 
   FractionBox["3323", "5184"], ",", 
   FractionBox[
    RowBox[{"3", " ", 
     RowBox[{"(", 
      RowBox[{"u", "+", 
       RowBox[{"2", " ", "\[Sigma]"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"335", " ", "u"}], "+", 
       RowBox[{"2258", " ", "\[Sigma]"}]}], ")"}]}], 
    RowBox[{"59552", " ", 
     SuperscriptBox["\[Sigma]", "3"]}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"135", " ", 
      SuperscriptBox["u", "2"]}], "+", 
     RowBox[{"1836", " ", "u", " ", "\[Sigma]"}], "+", 
     RowBox[{"6466", " ", 
      SuperscriptBox["\[Sigma]", "2"]}]}], 
    RowBox[{"26584", " ", 
     SuperscriptBox["\[Sigma]", "3"]}]]}], "}"}]], "Output",
 CellChangeTimes->{3.83822439689697*^9, 3.8382244389278297`*^9},
