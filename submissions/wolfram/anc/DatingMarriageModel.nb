Cell[BoxData[
 RowBox[{
  RowBox[{
  "Here", " ", "we", " ", "define", " ", "a", " ", "function", " ", "that", 
   " ", "gives", " ", 
   FormBox[
    RowBox[{
     SubscriptBox["b", 
      RowBox[{"t", "+", "1"}]], ",", 
     RowBox[{
      SubscriptBox["r", 
       RowBox[{"t", "+", "1"}]], 
      SubscriptBox["p", 
       RowBox[{"c", "(", 
        RowBox[{"t", "+", "1"}], ")"}]], 
      SubscriptBox["p", 
       RowBox[{"s", "(", 
        RowBox[{"t", "+", "1"}], ")"}]]}]}],
    TraditionalForm], " ", "given", " ", 
   FormBox[
    RowBox[{
     SubscriptBox["b", "t"], ",", 
     SubscriptBox["r", "t"], ",", 
     SubscriptBox["p", "ct"], ",", 
     SubscriptBox["p", "st"]}],
    TraditionalForm], " ", "for", " ", "the", " ", "Uniform", " ", "model", 
   " ", "with", " ", "pA"}], "=", 
  RowBox[{"p0", "=", 
   RowBox[{"NormalDistribution", ":"}]}]}]], "Text",
