Cell[CellGroupData[{

Cell["2.3. Discussion, comments and empirical comparison", "Subsection",
 CellChangeTimes->{{3.8382108963138733`*^9, 3.83821089823449*^9}, 
   3.8382130176765614`*^9},ExpressionUUID->"66556d02-93a2-42f0-9b43-\
078fe3fd7ff8"],

Cell[CellGroupData[{

Cell["2.3.1 Men and women", "Subsubsection",
 CellChangeTimes->{{3.838212709445093*^9, 
  3.8382127153984528`*^9}},ExpressionUUID->"3742b64c-143e-4b77-ae45-\
4ebf0351a28a"],

Cell["\<\
A possible point of concern, is the fact that we did not distinguished man \
and woman in our model. To make explicit such a distinction, however, is not \
important for our conclusions. We can partition society into two, making \
matching just between agents not of the same group. For this situation, the \
matching is a random surjective function from the smallest partition to the \
largest one. A random subset of agents that make the large partition is left \
out from the matching process at each step. A slightly modification of our \
original implementation is sufficient for that and gives similar results.\
\>", "Text",
 CellChangeTimes->{{3.838224765958416*^9, 3.838224898025976*^9}, 
   3.838225060242679*^9, {3.8382927795839233`*^9, 
   3.8382928103413486`*^9}},ExpressionUUID->"7c7868b5-899f-4287-bc9f-\
9a2f48b30476"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "2.3.2 Generalizing to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", "s"], "\[NotEqual]", "\[Mu]"}], TraditionalForm]], 
  "Text",
  FormatType->"TraditionalForm",ExpressionUUID->
  "be92b700-7c37-44d8-80c7-ea1b3eda1f64"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "s"], "\[NotEqual]", "\[Sigma]"}], 
   TraditionalForm]], "Text",
  FormatType->"TraditionalForm",ExpressionUUID->
  "35a738fc-6205-42f1-817f-89248c03ae2c"]
}], "Subsubsection",
 CellChangeTimes->{{3.835779614967535*^9, 3.835779647015255*^9}, {
  3.835779927271473*^9, 3.835779950021978*^9}, {3.8357803728376083`*^9, 
  3.835780373715857*^9}, {3.838210974234865*^9, 3.838211017527454*^9}, {
  3.83821192765801*^9, 3.8382119545206537`*^9}, {3.8382126892877703`*^9, 
  3.838212694798998*^9}},ExpressionUUID->"99aec692-431f-49d8-97d5-\
f07394f4bcc6"],

Cell[TextData[{
 "So far we presented results in the case where all elements of the affinity \
matrix are generated by the same Gaussian distribution, that is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", "=", 
    SubscriptBox["\[Mu]", "s"]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "a6a38b66-e99e-4b41-9ff8-7c28f496c4ee"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", "=", 
    SubscriptBox["\[Sigma]", "s"]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "7ff0f2b2-8f64-4952-b3b5-8fdce1b4e8e2"],
 ". So, one might rightly worry that our results are not valid if this is not \
the case. To address this concern, we vary the distribution of the \
off-diagonal elements keeping the diagonal elements fixed at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "kk"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "e8192f64-8e7c-4153-9b2c-51858ccc8922"],
 ". Using"
}], "Text",
 CellChangeTimes->{{3.838211019727283*^9, 3.8382111337721767`*^9}, {
   3.838211172914946*^9, 3.838211177267325*^9}, 3.838211243605081*^9, {
   3.838211644462871*^9, 3.8382116614010572`*^9}, {3.838212046625242*^9, 
   3.8382120549575853`*^9}},ExpressionUUID->"6bdc7069-ed7a-4675-bedd-\
dd22dfb2b4f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"n", "=", "1000"}], ",", 
    RowBox[{"\[Sigma]", "=", "1"}], ",", 
    RowBox[{"\[Mu]s", "=", "0"}], ",", 
    RowBox[{"\[Sigma]s", "=", "0.00001"}], ",", 
    RowBox[{"\[CapitalLambda]", "=", "1"}], ",", 
    RowBox[{"T", "=", "100"}]}], "}"}], ";"}]], "Input",
 CellChangeTimes->{{3.838211186939184*^9, 3.838211195162323*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"d1de7e84-4d1c-4dea-8626-d40ae7dd8e9a"],

Cell[TextData[{
 "(for simplicity we used the Gaussian model for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Mu]", "s"], "=", "0"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "c605dac2-ac8e-4b59-a5f9-b79370ef54a9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Sigma]", "s"], "=", "0.00001"}], ","}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "48201ce8-2ab1-4292-bcc1-656d3375976a"],
 " which is approximately ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "kk"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "dd4b57c6-4ac6-4def-8add-f5f967770b76"],
 ") we run the simulation"
}], "Text",
 CellChangeTimes->{{3.8382112325097103`*^9, 3.838211239141815*^9}, {
  3.838211663131283*^9, 
  3.838211663584874*^9}},ExpressionUUID->"5c9aa1a1-9b56-4cf9-9dcd-\
762f46326146"],

Cell[BoxData[
 RowBox[{
  RowBox[{"r\[Mu]", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"DatingMarriageModel", "[", 
      RowBox[{
      "\"\<N\>\"", ",", "n", ",", "\[Mu]", ",", "\[Sigma]", ",", "\[Mu]s", 
       ",", "\[Sigma]s", ",", 
       RowBox[{"\[Mu]", "+", "\[Sigma]"}], ",", "T"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1", ",", "0", ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.835779650822825*^9, 3.8357796776879387`*^9}, {
  3.8357798341256533`*^9, 3.8357798396755447`*^9}, {3.835781170525041*^9, 
  3.835781170932074*^9}, {3.8382111484951973`*^9, 3.838211159188982*^9}, {
  3.838211197523118*^9, 3.838211215423792*^9}},
 CellLabel->
  "In[184]:=",ExpressionUUID->"36737046-b570-4ce5-a561-066fcb024c59"],

