Cell[TextData[{
 "By split the couples and singles we can make the histogram with the utility \
distribution at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "45459e51-c652-4d6f-aff9-3162dd1b13cf"],
 " for singles and couples and compare the results with the analytical \
distributions obtained"
}], "Text",
 CellChangeTimes->{{3.838224268481124*^9, 
  3.838224333342369*^9}},ExpressionUUID->"a03a6684-9f41-4a3e-b41a-\
34db984d4cf3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CouplesUtility", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"rU", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
       "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
      "\[LeftDoubleBracket]", "n", "\[RightDoubleBracket]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"rU", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}],
          "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}]}], 
      "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SinglesUtility", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"rU", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
       "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
      "\[LeftDoubleBracket]", "n", "\[RightDoubleBracket]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{"n", ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", "10000"}], "}"}]}], "]"}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
           "rU", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
           "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}]}], 
        "]"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[224]:=",ExpressionUUID->"5bd0c11c-9932-4773-a822-2e53bc04f728"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Histogram", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"CouplesUtility", ",", "SinglesUtility"}], "}"}], ",", "50", 
     ",", "\"\<PDF\>\""}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ps1", "/.", 
