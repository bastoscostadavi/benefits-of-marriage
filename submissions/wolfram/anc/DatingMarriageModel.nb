Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"b1", ",", "r1", ",", "pc1", ",", "ps1"}], "}"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"NextStep", "[", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", "\[Sigma]"}]], ",", 
      FractionBox["1", 
       RowBox[{"4", "\[Sigma]"}]], ",", "0", ",", "0", ",", "1"}], "]"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "\[Sigma]"}], "<", "u", "<", 
      RowBox[{"2", "\[Sigma]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.835820250434116*^9, 3.83582026584356*^9}, {
  3.838223672876737*^9, 3.8382236899240513`*^9}, {3.838223799368325*^9, 
