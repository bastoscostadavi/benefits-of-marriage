Cell[TextData[{
 "Because we are concerned with large societies, we are more interested in \
the average utility ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "t"], TraditionalForm]],ExpressionUUID->
  "462cdd87-3753-43e1-b5f9-b5c94e74b6eb"],
 " and its variance than in individual utilities ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["u", "k"], "t"], TraditionalForm]],ExpressionUUID->
  "353071c4-d32f-4d77-a56b-842280a46a67"],
 ". The marked difference between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["u", "k"], "t"], TraditionalForm]],ExpressionUUID->
  "3ce9e911-a999-4cc8-970a-83a411f519ac"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "t"], TraditionalForm]],ExpressionUUID->
  "fbc298bb-ff9e-43c8-8b6f-41e744a86f3e"],
 " can be visualized by plotting their values. The utilities of agents ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "3"}], TraditionalForm]],ExpressionUUID->
  "178668fe-71c1-4412-9daf-e5ce62cbe9c7"],
 " and ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]],ExpressionUUID->
  "e62b987a-064f-4d8b-9eea-6d14bb798a60"],
 " evolves as:"
}], "Text",
