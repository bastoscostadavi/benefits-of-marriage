Cell["\<\
If one of the agents of the new couple was dating before, it will break apart \
with its previous mate:\
\>", "Text",
 CellChangeTimes->{{3.838202911303297*^9, 3.83820292706665*^9}, {
   3.8382032686573763`*^9, 3.83820349574291*^9}, 3.838203633286425*^9, 
   3.838203667651142*^9, 3.838203719919359*^9, {3.83820375730746*^9, 
   3.838203835111347*^9}},ExpressionUUID->"44a9e45d-5da9-4ec2-8acf-\
57186f61b45c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"BreakingAgents", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", "NewCouples", "]"}], ",", 
     RowBox[{
      RowBox[{"MemberQ", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
         "Couples", "\[LeftDoubleBracket]", "t", "\[RightDoubleBracket]"}], 
         "]"}], ",", "#"}], "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CouplesToBreak", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{
     "Couples", "\[LeftDoubleBracket]", "t", "\[RightDoubleBracket]"}], ",", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"BreakingAgents", ",", 
         RowBox[{
         "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "]"}],
        " ", "||", " ", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"BreakingAgents", ",", " ", 
         RowBox[{
         "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
        "]"}]}], " ", "&"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8382038199314337`*^9, 3.838203841847933*^9}, {
  3.838204016121705*^9, 3.838204056174239*^9}, {3.838204120210464*^9, 
  3.838204138688274*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"5c131202-f824-4b86-9015-65774fc79672"],

Cell[TextData[{
 "Then, the couples at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "fc4f861d-d17c-4966-aabe-979334b83840"],
 " will be the set of Couples at ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "992437cb-de91-47c0-94c4-374efd9caddd"],
 ", plus the set of NewCouples, minus the CouplesToBreak:"
}], "Text",
 CellChangeTimes->{{3.838203843943399*^9, 3.838203948776332*^9}, {
  3.8382041898628273`*^9, 3.8382041924148073`*^9}, {3.8382922590037327`*^9, 
  3.8382922592435713`*^9}},ExpressionUUID->"c962ba8b-0c76-4aab-b1ad-\
5fe20f8b87f6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Couples", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"Couples", ",", 
     RowBox[{"{", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Complement", "[", 
         RowBox[{
          RowBox[{
          "Couples", "\[LeftDoubleBracket]", "t", "\[RightDoubleBracket]"}], 
          ",", "CouplesToBreak"}], "]"}], ",", "NewCouples"}], "]"}], "}"}]}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Couples", "\[LeftDoubleBracket]", 
  RowBox[{"t", "+", "1"}], "\[RightDoubleBracket]"}]}], "Input",
 CellChangeTimes->{{3.838203952768445*^9, 3.838203958504406*^9}, {
  3.838204084616127*^9, 3.838204114091055*^9}, {3.8382922667165623`*^9, 
  3.838292274971285*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"e85dc1a9-6d08-4479-8b9d-3d89b089b64c"],

