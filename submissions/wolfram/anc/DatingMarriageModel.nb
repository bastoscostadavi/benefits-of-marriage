Cell["\<\
We showed the results for the system without marriage. Now we want to compare \
the simulation for different values of \[CapitalLambda] to see whether \
marriage can be beneficial or not. 
First we run the simulation for different values of \[CapitalLambda]:\
\>", "Text",
 CellChangeTimes->{{3.83820553567332*^9, 3.838205538936762*^9}, {
  3.838205622774351*^9, 3.8382056394246817`*^9}, {3.838205820773767*^9, 
  3.838205855714994*^9}, {3.838210491029154*^9, 3.838210491984182*^9}, {
  3.838210612618354*^9, 
  3.838210668235552*^9}},ExpressionUUID->"74ad2121-b69e-4b62-ab2c-\
600814797cc2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"r\[CapitalLambda]", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"DatingMarriageModel", "[", 
      RowBox[{
      "\"\<N\>\"", ",", "n", ",", "\[Mu]", ",", "\[Sigma]", ",", "\[Mu]s", 
       ",", "\[Sigma]s", ",", "\[CapitalLambda]", ",", "T"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalLambda]", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1", ",", "0", ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.835778486511265*^9, 3.835778519879047*^9}, {
  3.8357785973749037`*^9, 3.835778657212565*^9}, {3.835778698791033*^9, 
  3.8357786990358887`*^9}, {3.835778752370603*^9, 3.835778788078383*^9}, {
  3.835779593980907*^9, 3.835779596415772*^9}, {3.835781162511232*^9, 
  3.835781162918042*^9}, {3.838205868571556*^9, 3.838205871619959*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"857b344e-b692-43f7-8388-d5e23fb2a193"],

Cell["\<\
We can plot the evolution of average utility in each system and we get:\
\>", "Text",
 CellChangeTimes->{{3.8382058804737787`*^9, 
  3.8382058980972843`*^9}},ExpressionUUID->"802581b9-bfde-4f29-b6a8-\
09120ee363e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"p\[CapitalLambda]", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Mean", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "r\[CapitalLambda]", "\[LeftDoubleBracket]", "\[CapitalLambda]", 
            "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "3", 
           "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "k", 
          "\[RightDoubleBracket]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "T"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[CapitalLambda]", ",", "1", ",", "5"}], "}"}]}], "]"}], ",", 
    
    RowBox[{"PlotLegends", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\[CapitalLambda]=2\>\"", ",", "\"\<\[CapitalLambda]=1\>\"", ",", 
