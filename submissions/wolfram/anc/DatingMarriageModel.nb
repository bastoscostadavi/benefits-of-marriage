Cell[CellGroupData[{

Cell["3.2. Distribution for married couples:", "Subsection",
 CellChangeTimes->{{3.8357816028722343`*^9, 3.835781633999077*^9}, {
  3.835781677182521*^9, 3.835781681909721*^9}, {3.838213509610424*^9, 
  3.8382135189780912`*^9}},ExpressionUUID->"b3236ebd-2b8c-465e-a89c-\
0f181d7c9437"],

Cell["\<\
In the model with marriage, married couples decouple from the system because \
they do not break. More precisely, they are not selected in the matching \
process. This sole fact, allows us to derive an expression for the utility \
distribution for married couples. Here we just compare the distribution we \
computed with the simulation:\
\>", "Text",
 CellChangeTimes->{{3.838213562906266*^9, 
  3.8382135981433783`*^9}},ExpressionUUID->"5165bec6-bf8b-4d33-aab6-\
f2abbb1c44b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rU", "=", 
   RowBox[{"DatingMarriageModel", "[", 
    RowBox[{
    "\"\<U\>\"", ",", "1000", ",", "0", ",", "1", ",", "0", ",", "1", ",", 
     "1", ",", "100"}], "]"}]}], ";", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"Histogram", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"rU", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
       "\[LeftDoubleBracket]", "100", "\[RightDoubleBracket]"}], ",", "100", 
      ",", "\"\<PDF\>\""}], "]"}], ",", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", 
           FractionBox[
            RowBox[{
             RowBox[{"2", "\[Sigma]"}], "-", "\[CapitalLambda]"}], 
            RowBox[{
             RowBox[{"2", "\[Sigma]"}], "-", "u"}]], "]"}], 
          RowBox[{"HeavisideTheta", "[", 
           RowBox[{"u", "-", "\[CapitalLambda]"}], "]"}], 
          FractionBox["1", 
           RowBox[{"4", "\[Sigma]"}]]}], "+", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"4", "\[Sigma]"}]], 
          FractionBox[
           RowBox[{"\[CapitalLambda]", "+", 
            RowBox[{"2", "\[Sigma]"}]}], 
           RowBox[{
            RowBox[{"2", "\[Sigma]"}], "-", "\[CapitalLambda]"}]], 
          RowBox[{"HeavisideTheta", "[", 
           RowBox[{"u", "-", "\[CapitalLambda]"}], "]"}]}]}], ")"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Sigma]", "\[Rule]", "1"}], ",", 
         RowBox[{"\[CapitalLambda]", "\[Rule]", "1"}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", 
        RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.835781515740336*^9, 3.8357815725099154`*^9}, {
  3.8358184513402853`*^9, 
  3.8358184562215843`*^9}},ExpressionUUID->"b1bac95e-07fa-427e-a2af-\
dfbf4c6a80e7"],

