Cell[TextData[{
 "We see that each element of the Matching is a pair of numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"j", ",", "k"}], "}"}], TraditionalForm]],ExpressionUUID->
  "908238f3-2c04-482c-b7ce-5f50db12795d"],
 " denoting the agents that match at the given step. \nThen, two agents that \
were matched at step ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "21088701-4d0f-4de6-80c8-514720d12523"],
 " will form a couple if they like themselves. That is, if their their \
affinities are higher then their utilities at ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "ddb00467-3faf-4e8b-a0a9-e77085b40d1d"],
 ". More precisely:"
}], "Text",
 CellChangeTimes->{{3.838202611640072*^9, 3.838202730685693*^9}, {
  3.838202855844763*^9, 3.838202907017469*^9}, {3.8382029429874268`*^9, 
  3.838202944801704*^9}, {3.838203245320966*^9, 3.838203259816681*^9}, {
  3.8382036682521963`*^9, 3.838203743110478*^9}, {3.838292223706407*^9, 
  3.838292223853828*^9}},ExpressionUUID->"037225a6-7b57-45e9-a89c-\
05f456ed9434"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Match", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b"}], "}"}], "=", 
       RowBox[{
       "Matching", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
      ";", 
      RowBox[{
       RowBox[{
        RowBox[{"A", "\[LeftDoubleBracket]", 
         RowBox[{"a", ",", "b"}], "\[RightDoubleBracket]"}], ">", 
        RowBox[{
         RowBox[{
         "Utility", "\[LeftDoubleBracket]", "t", "\[RightDoubleBracket]"}], 
         "\[LeftDoubleBracket]", "a", "\[RightDoubleBracket]"}]}], "&&", 
       RowBox[{
        RowBox[{"A", "\[LeftDoubleBracket]", 
         RowBox[{"b", ",", "a"}], "\[RightDoubleBracket]"}], ">", 
        RowBox[{
         RowBox[{
         "Utility", "\[LeftDoubleBracket]", "t", "\[RightDoubleBracket]"}], 
         "\[LeftDoubleBracket]", "b", "\[RightDoubleBracket]"}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "Matching", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"NewCouples", "=", 
  RowBox[{"Pick", "[", 
   RowBox[{"Matching", ",", "Match"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.838203720971092*^9, 3.838203727961338*^9}, {
  3.838204155866722*^9, 3.838204159399764*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"38f744b4-8d3f-440d-8102-aa22efcd7a35"],

