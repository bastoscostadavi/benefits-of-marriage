    RowBox[{"4", " ", "\[Sigma]"}]], ",", 
   FractionBox[
    RowBox[{"u", "+", 
     RowBox[{"4", " ", "\[Sigma]"}]}], 
    RowBox[{"16", " ", 
     SuperscriptBox["\[Sigma]", "2"]}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"1545", " ", 
      SuperscriptBox["u", "2"]}], "+", 
