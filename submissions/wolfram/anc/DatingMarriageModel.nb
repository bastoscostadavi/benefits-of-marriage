       RowBox[{"pc1", "/.", 
        RowBox[{"{", 
         RowBox[{"\[Sigma]", "\[Rule]", "1"}], "}"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]], "Input",
